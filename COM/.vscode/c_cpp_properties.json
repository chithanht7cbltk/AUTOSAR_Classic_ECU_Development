{
  "version": 4,
  "configurations": [
    {
      "name": "STM32F103 COM",
      "includePath": [
        "${workspaceFolder}",
        "${workspaceFolder}/autosar/include",
        "${workspaceFolder}/autosar/com",
        "${workspaceFolder}/autosar/pdur",
        "${workspaceFolder}/autosar/canif",
        "${workspaceFolder}/autosar/can",
        "${workspaceFolder}/autosar/lin",
        "${workspaceFolder}/autosar/linif",
        "${workspaceFolder}/config",
        "${workspaceFolder}/spl/inc",
        "${workspaceFolder}/spl/src",
        "${workspaceFolder}/../bsp/cmsis"
      ],
      "defines": [
        "USE_STDPERIPH_DRIVER",
        "STM32F10X_MD"
      ],
      "compilerPath": "arm-none-eabi-gcc",
      "compilerArgs": [
        "-mcpu=cortex-m3",
        "-mthumb"
      ],
      "cStandard": "c11",
      "cppStandard": "c++17",
      "intelliSenseMode": "gcc-arm",
      "browse": {
        "path": [
          "${workspaceFolder}",
          "${workspaceFolder}/autosar/include",
          "${workspaceFolder}/autosar/com",
          "${workspaceFolder}/autosar/pdur",
          "${workspaceFolder}/autosar/canif",
          "${workspaceFolder}/autosar/can",
          "${workspaceFolder}/autosar/lin",
          "${workspaceFolder}/autosar/linif",
          "${workspaceFolder}/config",
          "${workspaceFolder}/spl/inc",
          "${workspaceFolder}/spl/src",
          "${workspaceFolder}/../bsp/cmsis"
        ],
        "limitSymbolsToIncludedHeaders": false
      }
    }
  ]
}
